# Copy to .env for local tooling or inject these values from the deployment secret store.
# Never commit real credentials.
MYFOLDER_PROFILE=development
MYFOLDER_SERVER_PORT=8082
MYFOLDER_PUBLIC_BASE_URL=https://myfolder.example.com
MYFOLDER_TLS_ENABLED=true
MYFOLDER_TLS_KEY_STORE=file:/etc/myfolder/tls/myfolder.p12
MYFOLDER_TLS_KEY_STORE_PASSWORD=<keystore-password>
MYFOLDER_TLS_KEY_STORE_TYPE=PKCS12
MYFOLDER_TLS_KEY_ALIAS=myfolder
MYFOLDER_HTTP2_ENABLED=true
MYFOLDER_JWT_SECRET=<at-least-32-random-bytes>
MYFOLDER_JWT_EXPIRATION=7d

MYFOLDER_DB_URL=jdbc:mysql://localhost:3306/myfolder_development?useUnicode=true&characterEncoding=UTF-8
MYFOLDER_DB_USERNAME=myfolder
MYFOLDER_DB_PASSWORD=<database-password>

MYFOLDER_REDIS_HOST=localhost
MYFOLDER_REDIS_PORT=6379
MYFOLDER_REDIS_USERNAME=
MYFOLDER_REDIS_PASSWORD=<redis-password>

MYFOLDER_STORAGE_ROOT=/srv/myfolder/storage
MYFOLDER_TRANSFER_METADATA_ROOT=/srv/myfolder/metadata/upload-tasks
MYFOLDER_DEVICE_METADATA_FILE=/srv/myfolder/metadata/devices.json
MYFOLDER_FORWARD_METADATA_FILE=/srv/myfolder/metadata/forwards.json
MYFOLDER_LOG_FILE=/var/log/myfolder/server.log
